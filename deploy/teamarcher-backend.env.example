# Store the real production file only at /etc/teamarcher/backend.env (mode 0640).
# Never commit that file or any production credentials.
DATABASE_URL=postgresql+psycopg://teamarcher:CHANGE_ME@127.0.0.1:5432/teamarcher
DATABASE_AUTO_CREATE=false
JWT_SECRET=GENERATE_A_LONG_RANDOM_VALUE
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://divyanshtripathi31.github.io
# Production S3 uses the EC2 IAM role/default AWS provider chain. Never put
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or S3 endpoints in this file.
S3_BUCKET=
AWS_REGION=ap-south-1
SEED_INITIAL_USERS=false
INITIAL_USER_PASSWORDS_JSON={}
MAX_UPLOAD_MB=50
